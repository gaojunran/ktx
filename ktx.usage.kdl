// @generated by clikt-usage from Clikt metadata
name ktx
bin ktx
cmd run {
        flag --frozen help="Resolve only from lockfile; no network"
        flag --lock help="Run online and refresh the lockfile"
        flag --daemon help="Run via ktx daemon (eliminates compiler cold start). Also enabled by KTX_DAEMON=1."
        flag --forward-stdin help="Stream ktx's own stdin to the script in the daemon (off by default; enabling this delays process shutdown by ~300ms while waiting for stdin reads to unblock)."
        arg <SCRIPT>
        arg "[ARGS]…" required=#false var=#true
}
cmd eval {
        flag "-e --expr" help="Kotlin expression or statement to execute" required=#true {
                arg <EXPR>
        }
        arg "[ARGS]…" required=#false var=#true
}
cmd lock {
        arg <SCRIPT>
}
cmd add {
        flag --no-lock help="Edit the script only; skip lockfile refresh"
        arg <COORDINATES>
        arg <SCRIPT>
}
cmd compile {
        flag "-o --output" help="Output path. With --self-contained this is a directory; with --native a binary; otherwise a jar file (defaults to <script>.jar / <script>/ / <script> next to the script)." {
                arg <OUTPUT>
        }
        flag --self-contained help="Bundle a minimal JRE alongside the fat jar so end users do not need Java installed. Output is a directory tree (host platform only)."
        flag --native help="Build a single-file native binary via GraalVM native-image. Requires `native-image` on PATH or under $GRAALVM_HOME / $JAVA_HOME. Produces a ~10-20 MB binary that needs no JRE. Mutually exclusive with --self-contained."
        flag --collect-metadata help="Only meaningful with --native: run the fat jar once under native-image-agent to capture reflection / resource accesses before native-image starts. The captured metadata is saved to <script>.native-meta/ and re-used on subsequent builds."
        arg <SCRIPT>
}
cmd toolchain {
        cmd list
        cmd install {
                arg <MAJOR>
        }
        cmd path {
                arg <MAJOR>
        }
}
cmd daemon {
        cmd status {
                flag --all help="List every daemon"
                flag --jdk help="Target JDK major version (default: current)" {
                        arg <JDK>
                }
        }
        cmd stop {
                flag --all help="Stop every daemon"
                flag --jdk help="Target JDK major version (default: current)" {
                        arg <JDK>
                }
        }
        cmd logs {
                flag --all help="Dump every daemon's log"
                flag --jdk help="Target JDK major version (default: current)" {
                        arg <JDK>
                }
                flag "-n --tail" help="Number of trailing lines to print (default 100). Use 0 for the full log." default="100" {
                        arg <TAIL>
                }
                flag --path help="Print just the log file path; do not dump contents."
        }
}
cmd cache {
        cmd info
        cmd clean
        cmd gc {
                flag --max-size help="Cap on total cache size, e.g. 2GB / 500MB / 100KB. Default 2GB." default="2GB" {
                        arg <MAX_SIZE>
                }
        }
}
cmd usage

